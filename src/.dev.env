# Переменная окружения (также известная как «env var») - это переменная, которая живет вне кода Python,
# в операционной системе, и может быть прочитана вашим кодом Python (или другими программами).

APP_NAME=API_Task_Manager
API_MODE=dev
ACCESS_SECRET=
ALGORITHM=HS256

# lifetime of access token (sec)
ACCESS_EXP=1800

REFRESH_SECRET=
# lifetime of refresh token (sec). 604800 сек = 7 дней
REFRESH_EXP=604800

# TEST configuration
DB_HOST=localhost
DB_PORT=5432
DB_USER=
DB_PASS=
DB_NAME=clients
DB_DRIVER_SYNC=psycopg2
DB_DRIVER_ASYNC=asyncpg

# SMTP (Yandex Mail, SSL port 465)
SMTP_HOST=smtp.yandex.ru
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=

# reg_token cookie (шаг 2→3 регистрации) — отдельный секрет от access/refresh
REG_TOKEN_SECRET=
REG_TOKEN_EXP=1200

# CRM «Руководитель» integration
CRM_API_URL=
CRM_API_KEY=
CRM_API_USER=api_user
CRM_API_PASSWORD=
CRM_LOGIN_URL=
CRM_DEMO_ID=4909
# ID группы «Сотрудник» — все пользователи Task Manager попадают в неё
CRM_USER_GROUP_ID=6
